APP_NAME="InvoiceQu AI Computer Vision"
PORT=8010

COMPUTER_VISION_DB_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"
COMPUTER_VISION_API_KEY="change-me"

FACE_THRESHOLD=0.78
FACE_THRESHOLD_ENHANCED=0.88
FACE_THRESHOLD_FALLBACK=0.94
MIN_FACE_SIZE=80
MIN_LIVENESS_SCORE=0.45

# Enhanced OpenCV detection is enabled by default (multi-cascade + CLAHE + NMS).
# This improves accuracy significantly even in lite mode at zero extra cost.
ENHANCED_DETECTION_ENABLED=true

# AWS Free Tier / lite mode defaults.
INSIGHTFACE_ENABLED=false
YOLO_ENABLED=false
YOLO_FACE_ENABLED=false
ANTI_SPOOF_ENABLED=false

# --- Tier 1: InsightFace (heavy, best accuracy) ---
INSIGHTFACE_MODEL_NAME="buffalo_l"
INSIGHTFACE_DET_SIZE=640
INSIGHTFACE_CTX_ID=-1

# --- Tier 2: YOLO-Face detection (medium, fast) ---
# Requires a YOLO model trained for face detection (e.g. yolov8n-face.pt)
YOLO_FACE_MODEL_PATH=""
YOLO_FACE_CONFIDENCE=0.40

# --- YOLO object/fraud detection ---
YOLO_MODEL_PATH=""
YOLO_CONFIDENCE=0.35
YOLO_SUSPICIOUS_CLASSES="cell phone,tv,laptop,book,remote,keyboard,mouse"

# --- Anti-spoofing deep model (TensorFlow/Keras) ---
ANTI_SPOOF_MODEL_PATH=""
ANTI_SPOOF_THRESHOLD=0.60
ANTI_SPOOF_INPUT_SIZE=224
